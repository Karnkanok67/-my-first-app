import time
import streamlit as st

st.title("⏱️ เกมเติมศัพท์จับเวลา")

# ----------------------------------------------------
# 1. กำหนดค่าเริ่มต้นใน session_state
# ----------------------------------------------------
if "ans1_val" not in st.session_state:
    st.session_state.ans1_val = ""

if "ans2_val" not in st.session_state:
    st.session_state.ans2_val = ""

if "ans3_val" not in st.session_state:
    st.session_state.ans3_val = ""

if "ans4_val" not in st.session_state:
    st.session_state.ans4_val = ""

if "ans5_val" not in st.session_state:
    st.session_state.ans5_val = ""

if "start" not in st.session_state:
    st.session_state.start = None

if "is_ended" not in st.session_state:
    st.session_state.is_ended = False


# ----------------------------------------------------
# 2. ฟังก์ชันเริ่มเกมใหม่
# ----------------------------------------------------
def reset_game():
    st.session_state.ans1_val = ""
    st.session_state.ans2_val = ""
    st.session_state.ans3_val = ""
    st.session_state.ans4_val = ""
    st.session_state.ans5_val = ""

    st.session_state.start = time.time()
    st.session_state.is_ended = False


# ----------------------------------------------------
# 3. ฟังก์ชันแสดงผลคะแนน
# ----------------------------------------------------
@st.dialog("📊 สรุปผลการเล่นเกม")
def show_result_dialog(ans1, ans2, ans3, ans4, ans5):

    st.balloons()

    score = 0

    # แปลงคำตอบให้เป็นตัวพิมพ์เล็กและตัดช่องว่าง
    u_ans1 = ans1.strip().lower()
    u_ans2 = ans2.strip().lower()
    u_ans3 = ans3.strip().lower()
    u_ans4 = ans4.strip().lower()
    u_ans5 = ans5.strip().lower()

    # ------------------------------------------------
    # ตรวจข้อ 1
    # ------------------------------------------------
    if u_ans1 == "เชียงใหม่":
        st.success("✅ ข้อ 1: ถูกต้อง")
        score += 1
    else:
        st.error(
            f"❌ ข้อ 1: ยังไม่ถูกต้อง "
            f"(คุณตอบ '{u_ans1}')"
        )

    # ------------------------------------------------
    # ตรวจข้อ 2
    # ------------------------------------------------
    if u_ans2 == "ขอนแก่น":
        st.success("✅ ข้อ 2: ถูกต้อง")
        score += 1
    else:
        st.error(
            f"❌ ข้อ 2: ยังไม่ถูกต้อง "
            f"(คุณตอบ '{u_ans2}')"
        )

    # ------------------------------------------------
    # ตรวจข้อ 3
    # ------------------------------------------------
    if u_ans3 == "อยุธยา":
        st.success("✅ ข้อ 3: ถูกต้อง")
        score += 1
    else:
        st.error(
            f"❌ ข้อ 3: ยังไม่ถูกต้อง "
            f"(คุณตอบ '{u_ans3}')"
        )

    # ------------------------------------------------
    # ตรวจข้อ 4
    # ------------------------------------------------
    if u_ans4 == "สงขลา":
        st.success("✅ ข้อ 4: ถูกต้อง")
        score += 1
    else:
        st.error(
            f"❌ ข้อ 4: ยังไม่ถูกต้อง "
            f"(คุณตอบ '{u_ans4}')"
        )

    # ------------------------------------------------
    # ตรวจข้อ 5
    # ------------------------------------------------
    if u_ans5 == "ภูเก็ต":
        st.success("✅ ข้อ 5: ถูกต้อง")
        score += 1
    else:
        st.error(
            f"❌ ข้อ 5: ยังไม่ถูกต้อง "
            f"(คุณตอบ '{u_ans5}')"
        )

    # ------------------------------------------------
    # แสดงคะแนนรวม
    # ------------------------------------------------
    st.info(f"🏆 ได้คะแนนรวม: {score}/5 คะแนน")

    if score == 5:
        st.success("🎉 You win!")
    else:
        st.error("💀 You lose!")


# ----------------------------------------------------
# 4. ปุ่มเริ่มเล่นเกม
# ----------------------------------------------------
st.button(
    "🎮 เริ่มเล่นเกม",
    on_click=reset_game
)


# ----------------------------------------------------
# 5. แสดงเวลานับถอยหลัง
# ----------------------------------------------------
if (
    st.session_state.start is not None
    and not st.session_state.is_ended
):

    time_left = int(
        60 - (time.time() - st.session_state.start)
    )

    if time_left > 0:
        st.error(
            f"⏳ เหลือเวลา: {time_left} วินาที"
        )
    else:
        st.session_state.is_ended = True
        st.rerun()


st.divider()


# ----------------------------------------------------
# 6. ช่องรับคำตอบ
# ----------------------------------------------------

ans1 = st.text_input(
    "ข้อ 1: จังหวัดทางภาคเหนือ มีดอยสูงและอากาศเย็น",
    value=st.session_state.ans1_val
)

ans2 = st.text_input(
    "ข้อ 2: จังหวัดภาคอีสานที่มีแหล่งค้นพบฟอสซิลไดโนเสาร์",
    value=st.session_state.ans2_val
)

ans3 = st.text_input(
    "ข้อ 3: อดีตราชธานีของไทย มีโบราณสถานและวัดเก่าแก่จำนวนมาก",
    value=st.session_state.ans3_val
)

ans4 = st.text_input(
    "ข้อ 4: จังหวัดภาคใต้ มีหาดสมิหลาและรูปปั้นนางเงือก",
    value=st.session_state.ans4_val
)

ans5 = st.text_input(
    "ข้อ 5: จังหวัดเกาะทางภาคใต้ มีชายหาดและสถานที่ท่องเที่ยวมากมาย",
    value=st.session_state.ans5_val
)


# ----------------------------------------------------
# 7. บันทึกคำตอบล่าสุด
# ----------------------------------------------------
st.session_state.ans1_val = ans1
st.session_state.ans2_val = ans2
st.session_state.ans3_val = ans3
st.session_state.ans4_val = ans4
st.session_state.ans5_val = ans5


# ----------------------------------------------------
# 8. ปุ่มส่งคำตอบ
# ----------------------------------------------------
if (
    st.session_state.start is not None
    and not st.session_state.is_ended
):

    if st.button("📥 ส่งคำตอบ"):

        st.session_state.is_ended = True
        st.rerun()

    # ทำให้เวลานับถอยหลังทุก 1 วินาที
    time.sleep(1)
    st.rerun()


# ----------------------------------------------------
# 9. แสดง Dialog ผลลัพธ์
# ----------------------------------------------------
if st.session_state.is_ended:

    show_result_dialog(
        st.session_state.ans1_val,
        st.session_state.ans2_val,
        st.session_state.ans3_val,
        st.session_state.ans4_val,
        st.session_state.ans5_val
    )
